{
  "manifest_version": 3,
  "name": "Cozy Driver — drive while you watch",
  "version": "0.1.0",
  "description": "An endless, calm procedural driving game in a panel beside whatever you are watching. Bundled, offline, and it never touches the page.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Cozy Driver" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["https://www.youtube.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["game/*", "panel.html"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+D" },
      "description": "Open Cozy Driver beside the page"
    }
  }
}
